# Reizoko server — web-root deployment (contents of server/ → zasian.ru root).
Options -Indexes

<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^src/ - [F,L]
    RewriteRule ^storage/ - [F,L]
</IfModule>

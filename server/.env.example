VK_APP_ID=
VK_CLIENT_SECRET=
VK_SERVICE_TOKEN=

REIZOKO_SERVER_URL=https://zasian.ru
VK_REDIRECT_URI=https://zasian.ru/vk-callback.php

# public (default) — token exchange uses PKCE only, no service_token.
# confidential — set if the VK app is marked confidential in VK ID cabinet.
# VK_OAUTH_APP_KIND=confidential

# Set to 1 on staging to show detailed OAuth error stages on callback page.
# REIZOKO_DEBUG=1

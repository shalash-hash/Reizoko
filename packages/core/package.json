{
  "name": "@reizoko/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage"
  },
  "dependencies": {
    "@reizoko/platform-sdk": "workspace:*",
    "@reizoko/shared": "workspace:*",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
